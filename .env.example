# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
APP_ENV=development
FLASK_DEBUG=0
SECRET_KEY=your_secret_key_here_generate_a_random_string
# Set to 1 only when serving the application over HTTPS.
SESSION_COOKIE_SECURE=0
# For local HTTP Google OAuth testing only; omit this in production.
# OAUTHLIB_INSECURE_TRANSPORT=1

# Database Configuration
DATABASE_URL=sqlite:///site.db
BUSINESS_TIMEZONE=Asia/Manila

# Server Configuration (Optional - for email links)
# Example: 127.0.0.1:5000 or yourdomain.com
SERVER_NAME=

# Email Settings (Required for Notifications)
# Keep enabled for local testing; set to 0 when configuring real email delivery.
MAIL_SUPPRESS_SEND=1
# Use Gmail App Password (not your regular password)
# How to get App Password: https://support.google.com/accounts/answer/185833
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Google OAuth Configuration (Required for Google Sign-In)
# Follow the setup instructions in README.md to obtain these credentials
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
# Set this to the exact callback registered with Google, especially in production.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5001/auth/google/callback
